# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns without a leading slash match at every depth in the monorepo
# (apps/*, packages/*, supabase/, etc.), not just the root.

# ============================================================
# Environment
# ============================================================
.env
.env*.local

# ============================================================
# Secrets & credentials
# ============================================================
*.pem
*.key
*.crt
*.p12
*.pfx
*service-account*.json
*firebase-adminsdk*.json

# ============================================================
# Build artifacts & caches
# ============================================================
node_modules
.pnp
.pnp.js
.next/
out/
build
dist
.turbo
.vercel
*.tsbuildinfo
coverage
.expo/
expo-env.d.ts

# ============================================================
# Local config (machine-specific, never shared)
# ============================================================
.claude/settings.local.json

# ============================================================
# Supabase local dev
# ============================================================
supabase/.branches
supabase/.temp
supabase/functions/.vercel
*.dump
*.sqlite
*.sqlite3

# ============================================================
# OS / editor junk
# ============================================================
.DS_Store
Thumbs.db
*.log
